# Copy to .env (repo root) and fill in. Never commit .env.

GOOGLE_API_KEY=
# Free-tier ids verified 2026-09 at ai.google.dev/gemini-api/docs/pricing; check AI Studio for your limits.
GEMINI_CEO_MODEL=gemini-3.8-flash
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
# Reserved for the next phase's judge; must differ from GEMINI_AGENT_MODEL.
GEMINI_JUDGE_MODEL=gemini-3.6-flash
LLM_REQUESTS_PER_SECOND=0.2
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Fine-grained PAT, read-only (metadata, contents, issues, pull requests). Empty = offline fixtures.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_CACHE_TTL_SECONDS=900

DATABASE_URL=sqlite:///./data/org.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
SEED=42
SEED_MAX_REPOS=12
CURRENCY=INR

MAX_PEER_HOPS=2
MAX_PEER_CALLS_PER_AGENT=3
GRAPH_RECURSION_LIMIT=40
